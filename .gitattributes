# 统一换行符处理，避免跨平台（Windows/macOS/Linux）clone 时被自动转换搞坏

# 默认：文本文件由 git 规范化为 LF 入库，检出时按平台处理
* text=auto

# Windows 批处理脚本必须是 CRLF
*.bat           text eol=crlf
*.cmd           text eol=crlf

# Unix shell 脚本必须是 LF（否则在 Mac/Linux 上报 bad interpreter）
gradlew         text eol=lf
*.sh            text eol=lf

# 源码统一 LF
*.java          text eol=lf
*.json          text eol=lf
*.gradle        text eol=lf
*.properties    text eol=lf
*.md            text eol=lf

# 二进制文件不做换行符转换
*.jar           binary
*.png           binary
*.ico           binary
